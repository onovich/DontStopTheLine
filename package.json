{
  "name": "dont-stop-the-line",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format:check": "prettier --check .",
    "arch:check": "dependency-cruiser --validate .dependency-cruiser.cjs packages apps",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm arch:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.1.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
