{
  "name": "dont-stop-the-line",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format:check": "prettier --check .",
    "arch:check": "dependency-cruiser --validate .dependency-cruiser.cjs packages apps",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm arch:check"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
